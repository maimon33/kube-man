# Copy this file to .env and fill the values locally. Never commit .env.

# --- Remote / server deployment --------------------------------------------
# Address KubeMan listens on. 127.0.0.1 (default) is reachable only from the
# machine itself; use 0.0.0.0 to serve other machines.
# KUBEMAN_BIND=0.0.0.0
# KUBEMAN_PORT=3080

# The exact URL people type in their browser. Google sign-in redirects back to
# it, so set it whenever KubeMan is not opened as http://localhost:3080, e.g.
# behind your own TLS proxy. Leave empty to derive it from the request.
# KUBEMAN_PUBLIC_URL=https://kubeman.example.com

# Optional built-in HTTPS: a domain that points at this server. Requires
# KUBEMAN_PORT=80 and KUBEMAN_HTTPS_PORT=443 so the certificate can be issued.
# KUBEMAN_SITE_ADDRESS=kubeman.example.com

# --- Optional public Google OAuth application for the KubeMan project -------
KUBEMAN_GOOGLE_CLIENT_ID=
KUBEMAN_GOOGLE_CLIENT_SECRET=
